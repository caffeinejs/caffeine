{
  "name": "@caffeinejs/http-fastify-adapter",
  "version": "0.0.0",
  "description": "Caffeine http fastify adapter package",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --build --force tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@caffeinejs/core": "*",
    "@caffeinejs/http": "*"
  },
  "peerDependencies": {
    "@fastify/multipart": "^10.0.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@fastify/multipart": {
      "optional": true
    },
    "fastify": {
      "optional": false
    },
    "fastify-plugin": {
      "optional": false
    }
  },
  "devDependencies": {
    "@fastify/multipart": "^10.0.0",
    "@types/supertest": "^7.2.0",
    "fastify": "^5.8.5",
    "fastify-plugin": "^6.0.0",
    "supertest": "^7.2.2"
  }
}
