{
  "name": "@caffeinejs/devtools",
  "version": "0.0.0",
  "description": "CaffeineJS devtools: endpoints that describe a running application",
  "license": "MIT",
  "author": "Vitor Hugo Salgado (https://github.com/vitorsalgado)",
  "homepage": "https://github.com/caffeinejs/caffeine/tree/main/devtools#readme",
  "bugs": {
    "url": "https://github.com/caffeinejs/caffeine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caffeinejs/caffeine.git",
    "directory": "devtools"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.d.ts.map",
    "!dist/**/_spectypes"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52"
  },
  "peerDependencies": {
    "@caffeinejs/application": "0.0.0",
    "@caffeinejs/di": "0.0.0",
    "@caffeinejs/http": "0.0.0",
    "@caffeinejs/std": "0.0.0"
  },
  "devDependencies": {
    "@caffeinejs/brewer": "0.0.0",
    "@caffeinejs/testing": "0.0.0"
  }
}
