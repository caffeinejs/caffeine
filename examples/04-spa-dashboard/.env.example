# Every value has a default, so the example runs with none of these set. Copy to .env to override.

# Where the server listens.
SPA_SERVER__HOST=127.0.0.1
SPA_SERVER__PORT=9010

SPA_LOG__LEVEL=info

# Seals the session cookie (an encrypted JWT). At least 32 characters — the scheme refuses anything shorter.
SPA_AUTH__SESSION_SECRET=change-me-to-something-at-least-32-chars

# Signs the CSRF plugin's own cookie. Separate from the session secret so neither opens the other's.
SPA_AUTH__COOKIE_SECRET=change-me-too-at-least-32-characters-long

# Turn on behind TLS. On plain http a Secure cookie is never sent back, so the demo leaves it off.
SPA_AUTH__SECURE_COOKIE=false
