# Copy to .env and adjust. docker-compose sets these for the container automatically.
DATABASE_URL=postgresql://petstore:petstore@localhost:5432/petstore?schema=public
PETSTORE_JWT_SECRET=petstore-dev-secret

# Port the server listens on (default 9999, matching the GitHub callback below).
PORT=9999

# GitHub OAuth sign-in. Create an OAuth app at https://github.com/settings/developers and set the
# authorization callback URL to PETSTOREDEMO_AUTH_GITHUB_CALLBACK_URL below.
PETSTOREDEMO_AUTH_GITHUB_HOMEPAGE=http://localhost:9999/
PETSTOREDEMO_AUTH_GITHUB_CALLBACK_URL=http://localhost:9999/login/github/callback
PETSTOREDEMO_AUTH_GITHUB_CLIENT_ID=your-client-id
PETSTOREDEMO_AUTH_GITHUB_CLIENT_SECRET=your-client-secret
# Seals the OAuth state/session cookies. Use a random value of at least 32 characters.
PETSTOREDEMO_AUTH_GITHUB_SESSION_SECRET=change-me-to-a-random-32-char-string
