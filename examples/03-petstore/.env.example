# Copy to .env and adjust. Every setting other than these lives in config/application.yaml.
# Every variable below is optional except DATABASE_URL outside Docker: unset, a secret falls back to the demo value
# its placeholder in config/application.yaml names.

# Prisma's, not the application's: prisma.config.ts reads it for the `prisma migrate` / seed commands and the driver
# adapter reads it for the client, which is why it is not in the schema. docker-compose sets it for the container.
DATABASE_URL=postgresql://petstore:petstore@localhost:5432/petstore?schema=public

# HTTP Basic password for /docs (user `admin`, set in config/application.yaml). Defaults to admin123.
PETSTORE_DOCS_PASSWORD=admin123

# GitHub OAuth sign-in. Create an OAuth app at https://github.com/settings/developers and set its authorization
# callback URL to `auth.github.callbackUrl` in config/application.yaml.
PETSTORE_GITHUB_CLIENT_ID=your-client-id
PETSTORE_GITHUB_CLIENT_SECRET=your-client-secret
# Seals the OAuth state/session cookies. Use a random value of at least 32 characters.
PETSTORE_GITHUB_SESSION_SECRET=change-me-to-a-random-32-char-string
