# Copy to .env and adjust. docker-compose sets these for the container automatically.
# Every block below is optional: unset, the schema in src/app.config.ts supplies its defaults.

# Prisma's, not the application's: prisma/schema.prisma reads it directly, for the client and for the
# `prisma migrate` / seed commands, which is why it carries no PETSTORE_ prefix and is not in the schema.
DATABASE_URL=postgresql://petstore:petstore@localhost:5432/petstore?schema=public

# Server listen address (defaults 0.0.0.0 / 9999, the port matching the GitHub callback below).
PETSTORE_SERVER__HOST=0.0.0.0
PETSTORE_SERVER__PORT=9999

# Log level: trace, debug, info, warn, error, fatal. Defaults to info.
PETSTORE_LOG__LEVEL=info

# HTTP Basic credentials for /docs. Defaults to admin / admin123.
PETSTORE_DOCS__USER=admin
PETSTORE_DOCS__PASSWORD=admin123

# GitHub OAuth sign-in. Create an OAuth app at https://github.com/settings/developers and set the
# authorization callback URL to PETSTORE_AUTH__GITHUB__CALLBACK_URL below.
#
# A double underscore separates path segments, so CALLBACK_URL becomes the `callbackUrl` key.
#
# Browse the application from this host. The state cookie is set for the host the browser is on, and GitHub
# sends the browser back here: a sign-in started on http://127.0.0.1:9999 comes back to localhost without it.
PETSTORE_AUTH__GITHUB__CALLBACK_URL=http://localhost:9999/login/github/callback
PETSTORE_AUTH__GITHUB__CLIENT_ID=your-client-id
PETSTORE_AUTH__GITHUB__CLIENT_SECRET=your-client-secret
# Seals the OAuth state/session cookies. Use a random value of at least 32 characters.
PETSTORE_AUTH__GITHUB__SESSION_SECRET=change-me-to-a-random-32-char-string
