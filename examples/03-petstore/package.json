{
  "name": "@caffeinejs/example-petstore",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run generate && tsc",
    "generate": "prisma generate && caffeine generate",
    "prisma:generate": "prisma generate",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt .",
    "fmt": "oxfmt ."
  },
  "dependencies": {
    "@caffeinejs/di": "*",
    "@caffeinejs/http": "*",
    "@caffeinejs/multipart": "*",
    "@caffeinejs/openapi": "*",
    "@caffeinejs/static": "*",
    "@caffeinejs/std": "*",
    "@caffeinejs/view": "*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^10.1.3",
    "@fastify/view": "^12.0.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.0.0",
    "fastify": "^5.8.5",
    "handlebars": "^4.7.9",
    "jose": "^5.0.0"
  },
  "devDependencies": {
    "@caffeinejs/cli": "*",
    "@types/node": "^22.9.0",
    "oxfmt": "^0.5.0",
    "oxlint": "^1.80.0",
    "prisma": "^6.2.1",
    "tsx": "^4.22.4"
  }
}
