{
  "name": "@caffeinejs/example-petstore",
  "description": "Pet store application with HTML, OpenAPI, authentication, and PostgreSQL",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run generate && tsc",
    "generate": "prisma generate && caffeine generate modules",
    "prisma:generate": "prisma generate",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@caffeinejs/application": "0.0.0",
    "@caffeinejs/devtools": "0.0.0",
    "@caffeinejs/di": "0.0.0",
    "@caffeinejs/html": "0.0.0",
    "@caffeinejs/http": "0.0.0",
    "@caffeinejs/multipart": "0.0.0",
    "@caffeinejs/openapi": "0.0.0",
    "@caffeinejs/static": "0.0.0",
    "@caffeinejs/std": "0.0.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.9",
    "@kitajs/html": "^4.2.13",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.10",
    "pg": "^8.23.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@caffeinejs/brewer": "0.0.0",
    "@caffeinejs/cli": "0.0.0",
    "@caffeinejs/testing": "0.0.0",
    "@types/node": "^26.6.5",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15"
  }
}
