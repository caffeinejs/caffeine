{{#if avatar}}<img class="avatar" src="{{avatar}}" alt="" width="64" height="64">{{/if}}
<h1>Welcome, {{name}} 👋</h1>
<p class="lead">You are signed in to the Petstore API.</p>

<table>{{#each rows}}<tr><th>{{label}}</th><td>{{value}}</td></tr>{{/each}}</table>

<div class="actions">
  <a class="btn" href="/me">View raw <code>/me</code> JSON</a>
  <a class="btn primary" href="/logout">Sign out</a>
</div>
