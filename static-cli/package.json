{
  "name": "@caffeinejs/static-cli",
  "version": "0.0.0",
  "description": "Build and verify a CaffeineJS static release",
  "license": "MIT",
  "author": "Vitor Hugo Salgado (https://github.com/vitorsalgado)",
  "homepage": "https://github.com/caffeinejs/caffeine/tree/main/static-cli#readme",
  "bugs": {
    "url": "https://github.com/caffeinejs/caffeine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caffeinejs/caffeine.git",
    "directory": "static-cli"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.d.ts.map",
    "!dist/**/_spectypes",
    "bin.mjs"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "bin": {
    "caffeine-static": "./bin.mjs"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@caffeinejs/application": "0.0.0",
    "@caffeinejs/di": "0.0.0",
    "@caffeinejs/http": "0.0.0",
    "@caffeinejs/static": "0.0.0",
    "@caffeinejs/std": "0.0.0"
  }
}
