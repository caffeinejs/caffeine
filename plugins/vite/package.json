{
  "name": "@caffeinejs/vite-plugin",
  "version": "0.0.0",
  "description": "CaffeineJS vite plugin",
  "license": "MIT",
  "author": "Vitor Hugo Salgado (https://github.com/vitorsalgado)",
  "homepage": "https://github.com/caffeinejs/caffeine/tree/main/plugins/vite#readme",
  "bugs": {
    "url": "https://github.com/caffeinejs/caffeine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caffeinejs/caffeine.git",
    "directory": "plugins/vite"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.d.ts.map",
    "!dist/**/_spectypes"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist"
  },
  "peerDependencies": {
    "@caffeinejs/cli": "0.0.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "vite": "^8.3.6"
  }
}
