{
  "name": "@caffeinejs/eslint-plugin",
  "version": "0.0.0",
  "description": "CaffeineJS ESLint plugin",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
