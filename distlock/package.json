{
  "name": "@caffeinejs/distlock",
  "version": "0.0.0",
  "description": "Distributed locking for CaffeineJS",
  "license": "MIT",
  "author": "Vitor Hugo Salgado (https://github.com/vitorsalgado)",
  "homepage": "https://github.com/caffeinejs/caffeine/tree/main/distlock#readme",
  "bugs": {
    "url": "https://github.com/caffeinejs/caffeine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caffeinejs/caffeine.git",
    "directory": "distlock"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./backend/memory": {
      "types": "./dist/backend/memory/index.d.ts",
      "default": "./dist/backend/memory/index.js"
    },
    "./backend/redis": {
      "types": "./dist/backend/redis/index.d.ts",
      "default": "./dist/backend/redis/index.js"
    },
    "./backend/postgres": {
      "types": "./dist/backend/postgres/index.d.ts",
      "default": "./dist/backend/postgres/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "default": "./dist/observability/index.js"
    },
    "./observability/otel": {
      "types": "./dist/observability/otel/index.d.ts",
      "default": "./dist/observability/otel/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.d.ts.map",
    "!dist/**/_spectypes"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@caffeinejs/application": "0.0.0",
    "@caffeinejs/di": "0.0.0",
    "@caffeinejs/std": "0.0.0",
    "@opentelemetry/api": ">=1 <2",
    "@redis/client": "^6.2.1",
    "pg": "^8"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@redis/client": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0"
  }
}
