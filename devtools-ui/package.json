{
  "name": "@caffeinejs/devtools-ui",
  "version": "0.0.0",
  "description": "CaffeineJS devtools UI: a Caffeine application rendering what the devtools endpoints describe",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "caffeine-devtools": "./dist/main.js"
  },
  "files": [
