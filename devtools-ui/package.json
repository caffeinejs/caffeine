{
  "name": "@caffeinejs/devtools-ui",
  "version": "0.0.0",
  "description": "CaffeineJS devtools UI: a Caffeine application rendering what the devtools endpoints describe",
  "license": "MIT",
  "author": "Vitor Hugo Salgado (https://github.com/vitorsalgado)",
  "homepage": "https://github.com/caffeinejs/caffeine/tree/main/devtools-ui#readme",
  "bugs": {
    "url": "https://github.com/caffeinejs/caffeine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caffeinejs/caffeine.git",
    "directory": "devtools-ui"
  },
  "type": "module",
  "bin": {
    "caffeine-devtools": "./dist/main.js"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.d.ts.map",
    "!dist/**/_spectypes",
    "public"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@caffeinejs/application": "0.0.0",
    "@caffeinejs/brewer": "0.0.0",
    "@caffeinejs/devtools": "0.0.0",
    "@caffeinejs/di": "0.0.0",
    "@caffeinejs/html": "0.0.0",
    "@caffeinejs/http": "0.0.0",
    "@caffeinejs/static": "0.0.0",
    "@caffeinejs/std": "0.0.0",
    "@hpcc-js/wasm-graphviz": "^1.30.0",
    "@kitajs/html": "^4.2.13",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@caffeinejs/testing": "0.0.0",
    "jsdom": "^30.1.1"
  }
}
