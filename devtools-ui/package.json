    "@caffeinejs/http": "*",
    "@caffeinejs/static": "*",
    "@caffeinejs/std": "*",
    "@kitajs/html": "^4.2.13",
    "fastify": "^5.12.5",
    "mermaid": "^12.1.0"
  }
}
