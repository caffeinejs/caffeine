{
  "plain": "${env:NAME}",
  "spacedDefault": "${env:MISSING:-No Name}",
  "url": "postgres://${env:NAME}:5432/app",
  "escaped": "$${env:NAME}",
  "fromEscaped": "${config:escaped}",
  "${key}": "${env:NAME}",
  "list": ["${env:NAME}", "x-${env:NAME}"],
  "nested": { "deep": "${env:NAME}" },
  "nothing": null,
  "fromNothing": "${config:nothing:-d}",
  "port": 8080,
  "fromNumber": "port ${config:port}",
  "enabled": true,
  "fromBoolean": "${config:enabled}"
}
