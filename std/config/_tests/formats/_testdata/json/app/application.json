{
  "caffeine": { "name": "${env:SERVICE_NAME:-orders}" },
  "server": {
    "host": "${env:HOST:-0.0.0.0}",
    "port": "${env:PORT:-8080}",
    "shutdownDelay": "${env:SHUTDOWN_DELAY:-5s}"
  },
  "db": {
    "host": "localhost",
    "port": 5432,
    "name": "orders",
    "user": "${env:DB_USER:-orders}",
    "password": "dev-password",
    "url": "postgres://${config:db.user}@${config:db.host}:${config:db.port}/${config:db.name}",
    "pool": { "max": "${env:POOL_MAX:-10}", "ssl": "${env:DB_SSL:-false}" }
  },
  "features": {
    "search": "search-${env:SEARCH_BACKEND:-local}",
    "allowedOrigins": ["https://${env:DOMAIN:-localhost}", "https://admin.${env:DOMAIN:-localhost}"]
  },
  "banner": "${config:caffeine.name} listening on ${config:server.host}:${config:server.port}\nEvents go to ${config:messaging.queue}\n",
  "templates": { "greeting": "Hello $${user.name}" }
}
