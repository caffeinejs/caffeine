{
  "name": "@caffeinejs/std",
  "version": "0.0.0",
  "description": "Dependency-free utilities for CaffeineJS: durations, byte sizes and error messages",
  "license": "MIT",
  "author": "Vitor Hugo Salgado (https://github.com/vitorsalgado)",
  "homepage": "https://github.com/caffeinejs/caffeine/tree/main/std#readme",
  "bugs": {
    "url": "https://github.com/caffeinejs/caffeine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caffeinejs/caffeine.git",
    "directory": "std"
  },
  "type": "module",
  "exports": {
    "./bytes": {
      "types": "./dist/bytes/index.d.ts",
      "default": "./dist/bytes/index.js"
    },
    "./duration": {
      "types": "./dist/duration/index.d.ts",
      "default": "./dist/duration/index.js"
    },
    "./err": {
      "types": "./dist/err/index.d.ts",
      "default": "./dist/err/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.d.ts.map",
    "!dist/**/_spectypes"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  }
}
