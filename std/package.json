{
  "name": "@caffeinejs/std",
  "version": "0.0.0",
  "description": "Dependency-free utilities for CaffeineJS: durations, byte sizes and error messages",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    "./bytes": {
      "types": "./dist/bytes/index.d.ts",
      "default": "./dist/bytes/index.js"
    },
    "./duration": {
      "types": "./dist/duration/index.d.ts",
      "default": "./dist/duration/index.js"
    },
    "./err": {
      "types": "./dist/err/index.d.ts",
      "default": "./dist/err/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  }
}
