{
  "name": "@caffeinejs/std",
  "version": "0.0.0",
  "description": "Caffeine http package",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./config/typebox": {
      "types": "./dist/config/adapters/typebox.d.ts",
      "default": "./dist/config/adapters/typebox.js"
    },
    "./framework": {
      "types": "./dist/framework/index.d.ts",
      "default": "./dist/framework/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --build --force tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@caffeinejs/di": "*",
    "@standard-schema/spec": "^1.1.0"
  },
  "peerDependencies": {
    "@sinclair/typebox": ">=0.34.0 <1"
  },
  "peerDependenciesMeta": {
    "@sinclair/typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.49",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.0",
    "zod": "^4.4.3"
  }
}
