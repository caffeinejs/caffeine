{
  "name": "@caffeinejs/fetchy",
  "version": "0.0.0",
  "description": "CaffeineJS declarative, TC39-decorator-based HTTP client",
  "license": "MIT",
  "author": "Vitor Hugo Salgado (https://github.com/vitorsalgado)",
  "homepage": "https://github.com/caffeinejs/caffeine/tree/main/fetchy/fetchy#readme",
  "bugs": {
    "url": "https://github.com/caffeinejs/caffeine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caffeinejs/caffeine.git",
    "directory": "fetchy/fetchy"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./decorators": {
      "types": "./dist/decorators/index.d.ts",
      "default": "./dist/decorators/index.js"
    },
    "./fetch": {
      "types": "./dist/fetch/index.d.ts",
      "default": "./dist/fetch/index.js"
    },
    "./callback": {
      "types": "./dist/callback/index.d.ts",
      "default": "./dist/callback/index.js"
    },
    "./retry": {
      "types": "./dist/retry/index.d.ts",
      "default": "./dist/retry/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.d.ts.map",
    "!dist/**/_spectypes"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@caffeinejs/std": "0.0.0"
  }
}
