{
  "name": "@caffeinejs/fetchy",
  "version": "0.0.0",
  "description": "CaffeineJS declarative, TC39-decorator-based HTTP client",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./decorators": {
      "types": "./dist/decorators/index.d.ts",
      "default": "./dist/decorators/index.js"
    },
    "./builtin/fetch": {
      "types": "./dist/builtin/fetch/index.d.ts",
      "default": "./dist/builtin/fetch/index.js"
    },
    "./builtin/callback": {
      "types": "./dist/builtin/callback/index.d.ts",
      "default": "./dist/builtin/callback/index.js"
    },
    "./builtin/retry": {
      "types": "./dist/builtin/retry/index.d.ts",
      "default": "./dist/builtin/retry/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  }
}
