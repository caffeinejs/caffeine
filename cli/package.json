{
  "name": "@caffeinejs/cli",
  "version": "0.0.0",
  "description": "CaffeineJS build-time CLI",
  "license": "MIT",
  "author": "Vitor Hugo Salgado (https://github.com/vitorsalgado)",
  "homepage": "https://github.com/caffeinejs/caffeine/tree/main/cli#readme",
  "bugs": {
    "url": "https://github.com/caffeinejs/caffeine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caffeinejs/caffeine.git",
    "directory": "cli"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=24"
  },
  "bin": {
    "caffeine": "./dist/caffeine"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.d.ts.map",
    "!dist/**/_spectypes",
    "caffeinerc.schema.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json && npm run generate:schema",
    "generate:schema": "bun tools/generate_schema.ts",
    "compile": "bun build --compile bin.ts --outfile dist/caffeine",
    "clean:dist": "rm -rf dist",
    "test": "bun test",
    "test:typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4"
  }
}
