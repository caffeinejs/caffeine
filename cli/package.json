{
  "name": "@caffeinejs/cli",
  "version": "0.0.0",
  "description": "CaffeineJS build-time CLI",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.0.0"
  },
  "bin": {
    "caffeine": "./dist/caffeine"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "compile": "bun build --compile bin.ts --outfile dist/caffeine",
    "clean:dist": "rm -rf dist",
    "test": "bun test command",
    "test:typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
