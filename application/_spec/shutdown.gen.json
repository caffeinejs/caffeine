{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShutdownConfigSchema",
  "type": "object",
  "properties": {
    "drainDelay": {
      "pattern": "^(?:0|(?:(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:ns|us|µs|μs|ms|s|m|h|d))+)$",
      "type": "string"
    },
    "shutdownTimeout": {
      "pattern": "^(?:0|(?:(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:ns|us|µs|μs|ms|s|m|h|d))+)$",
      "type": "string"
    },
    "terminationGracePeriod": {
      "pattern": "^(?:0|(?:(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:ns|us|µs|μs|ms|s|m|h|d))+)$",
      "type": "string"
    },
    "signals": {
      "anyOf": [
        {
          "const": false,
          "type": "boolean"
        },
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "const": "SIGTERM",
                    "type": "string"
                  },
                  {
                    "const": "SIGINT",
                    "type": "string"
                  },
                  {
                    "const": "SIGHUP",
                    "type": "string"
                  },
                  {
                    "const": "SIGQUIT",
                    "type": "string"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
