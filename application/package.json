{
  "name": "@caffeinejs/application",
  "version": "0.0.0",
  "description": "Application framework for CaffeineJS: configuration, features, health, logging, schemas and shutdown",
  "license": "MIT",
  "author": "Vitor Hugo Salgado (https://github.com/vitorsalgado)",
  "homepage": "https://github.com/caffeinejs/caffeine/tree/main/application#readme",
  "bugs": {
    "url": "https://github.com/caffeinejs/caffeine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caffeinejs/caffeine.git",
    "directory": "application"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./config/argv": {
      "types": "./dist/config/sources/argv/index.d.ts",
      "default": "./dist/config/sources/argv/index.js"
    },
    "./config/env": {
      "types": "./dist/config/sources/env/index.d.ts",
      "default": "./dist/config/sources/env/index.js"
    },
    "./config/file": {
      "types": "./dist/config/sources/file/index.d.ts",
      "default": "./dist/config/sources/file/index.js"
    },
    "./config/inline": {
      "types": "./dist/config/sources/inline/index.d.ts",
      "default": "./dist/config/sources/inline/index.js"
    },
    "./config/json": {
      "types": "./dist/config/sources/json/index.d.ts",
      "default": "./dist/config/sources/json/index.js"
    },
    "./config/nodejs": {
      "types": "./dist/config/nodejs/index.d.ts",
      "default": "./dist/config/nodejs/index.js"
    },
    "./config/spring": {
      "types": "./dist/config/sources/spring/index.d.ts",
      "default": "./dist/config/sources/spring/index.js"
    },
    "./config/yaml": {
      "types": "./dist/config/sources/yaml/index.d.ts",
      "default": "./dist/config/sources/yaml/index.js"
    },
    "./framework": {
      "types": "./dist/framework/index.d.ts",
      "default": "./dist/framework/index.js"
    },
    "./health": {
      "types": "./dist/health/index.d.ts",
      "default": "./dist/health/index.js"
    },
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "default": "./dist/logger/index.js"
    },
    "./logger/console": {
      "types": "./dist/logger/console/index.d.ts",
      "default": "./dist/logger/console/index.js"
    },
    "./logger/pino": {
      "types": "./dist/logger/pino/index.d.ts",
      "default": "./dist/logger/pino/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./shutdown": {
      "types": "./dist/shutdown/index.d.ts",
      "default": "./dist/shutdown/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.d.ts.map",
    "!dist/**/_spectypes"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "@standard-schema/spec": "^1.1.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@caffeinejs/di": "0.0.0",
    "@caffeinejs/std": "0.0.0",
    "pino": "^10.3.1"
  },
  "peerDependenciesMeta": {
    "pino": {
      "optional": true
    }
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "json5": "^2.2.3",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  }
}
