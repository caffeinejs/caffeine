{
  "name": "@caffeinejs/typeorm",
  "version": "0.0.0",
  "description": "TypeORM integration for CaffeineJS",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/injection.js"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@caffeinejs/di": "*",
    "@caffeinejs/std": "*"
  },
  "peerDependencies": {
    "typeorm": "^0.3"
  },
  "devDependencies": {
    "sql.js": "^1.13.0",
    "typeorm": "^0.3.30"
  }
}
