{
  "name": "@caffeinejs/openapi",
  "version": "0.0.0",
  "description": "OpenAPI support for CaffeineJS",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@caffeinejs/di": "*",
    "@caffeinejs/http": "*",
    "@caffeinejs/std": "*",
    "@scalar/api-reference": "^1.0.0",
    "fastify": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@scalar/api-reference": {
      "optional": true
    }
  },
  "devDependencies": {
    "@caffeinejs/multipart": "*",
    "@scalar/api-reference": "^1.68.0",
    "fastify": "^5.12.4"
  }
}
