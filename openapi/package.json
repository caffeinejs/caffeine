{
  "name": "@caffeinejs/openapi",
  "version": "0.0.0",
  "description": "OpenAPI support for CaffeineJS",
  "license": "MIT",
  "author": "Vitor Hugo Salgado (https://github.com/vitorsalgado)",
  "homepage": "https://github.com/caffeinejs/caffeine/tree/main/openapi#readme",
  "bugs": {
    "url": "https://github.com/caffeinejs/caffeine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caffeinejs/caffeine.git",
    "directory": "openapi"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.d.ts.map",
    "!dist/**/_spectypes"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify-plugin": "^6.0.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@caffeinejs/application": "0.0.0",
    "@caffeinejs/http": "0.0.0",
    "@caffeinejs/std": "0.0.0",
    "@scalar/api-reference": "^1.0.0",
    "fastify": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@scalar/api-reference": {
      "optional": true
    }
  },
  "devDependencies": {
    "@caffeinejs/di": "0.0.0",
    "@caffeinejs/multipart": "0.0.0",
    "@scalar/api-reference": "^1.68.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.10"
  }
}
