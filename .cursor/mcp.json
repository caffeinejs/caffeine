{
  "mcpServers": {
    "sonarqube": {
      "type": "http",
      "url": "https://api.sonarcloud.io/mcp",
      "headers": {
        "Authorization": "Bearer ${env:CAFFEINE_SONARQUBE_TOKEN}",
        "SONARQUBE_ORG": "caffeinejs",
        "SONARQUBE_READ_ONLY": "true",
        "SONARQUBE_TOOLSETS": "issues,rules,quality-gates,measures"
      }
    },
    "scorecard": {
      "type": "stdio",
      "command": "${userHome}/go/bin/scorecard-mcp"
    }
  }
}
