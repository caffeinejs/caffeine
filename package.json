{
  "name": "caffeine",
  "version": "0.0.0",
  "description": "Caffeine monorepo",
  "license": "MIT",
  "author": "Vitor Hugo Salgado (https://github.com/vitorsalgado)",
  "private": true,
  "type": "module",
  "workspaces": [
    "http",
    "http-fastify-adapter"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "build:force": "tsc --build --force tsconfig.build.json",
    "clean": "tsc --build --clean tsconfig.build.json",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "fmt": "prettier . --write",
    "fmt:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "eslint": "^10.3.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "expect": "^29.7.0",
    "globals": "^17.6.0",
    "jest-mock": "^29.7.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
