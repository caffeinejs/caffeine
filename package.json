{
  "name": "caffeine",
  "version": "0.0.0",
  "description": "Caffeine monorepo",
  "license": "MIT",
  "author": "Vitor Hugo Salgado (https://github.com/vitorsalgado)",
  "private": true,
  "type": "module",
  "workspaces": [
    "http",
    "http-fastify-adapter"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "build:force": "tsc --build --force tsconfig.build.json",
    "clean": "tsc --build --clean tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "fmt": "prettier . --write",
    "fmt:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.40",
    "@types/node": "^22.9.0",
    "eslint": "^10.3.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.8"
  }
}
