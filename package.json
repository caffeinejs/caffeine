{
  "name": "@caffeinejs/monorepo",
  "version": "0.0.0",
  "description": "CaffeineJS monorepo",
  "license": "MIT",
  "author": "Vitor Hugo Salgado (https://github.com/vitorsalgado)",
  "homepage": "https://github.com/caffeinejs/caffeine#readme",
  "bugs": {
    "url": "https://github.com/caffeinejs/caffeine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caffeinejs/caffeine.git"
  },
  "engines": {
    "bun": "1.4.4",
    "node": ">=24"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "di",
    "std",
    "application",
    "http",
    "caching",
    "html",
    "multipart",
    "view",
    "static",
    "openapi",
    "messaging",
    "kafka",
    "distlock",
    "resilience",
    "integrations/*",
    "fetchy/*",
    "cli",
    "devtools",
    "devtools-ui",
    "testing",
    "brewer",
    "benchmarks",
    "di/examples/*",
    "examples/*",
    "plugins/*"
  ],
  "overrides": {
    "@opentelemetry/propagator-jaeger": "^2.9.0"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "build:force": "tsc --build --force tsconfig.build.json",
    "build:cli": "npm run build -w @caffeinejs/cli && npm run compile -w @caffeinejs/cli && chmod +x cli/dist/launcher.js && npm install -w @caffeinejs/cli --no-save",
    "build:examples": "test -f cli/dist/caffeine && test -x cli/dist/launcher.js || npm run build:cli && for d in examples/*/; do npm run build -w \"$d\" --if-present || exit 1; done",
    "clean": "npm run clean:dist --workspaces --if-present && tsc --build --clean tsconfig.build.json",
    "test": "vitest run && npm test -w @caffeinejs/cli",
    "test:e2e": "vitest run --config test/e2e/vitest.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:property": "vitest run prop.test",
    "test:watch": "vitest",
    "test:typecheck": "tsc --build tsconfig.check.json && npm run test:typecheck:benchmarks && npm run test:typecheck -w @caffeinejs/cli",
    "test:typecheck:benchmarks": "npm run test:typecheck -w @caffeinejs/benchmarks",
    "test:memory": "npm run test:memory --workspaces --if-present",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "lint:markdown": "markdownlint-cli2",
    "license:check": "node tools/check-licenses.mjs",
    "packages:check": "node tools/check-packages.mjs",
    "release:version": "node tools/release-version.mjs",
    "release:pack": "node tools/pack.mjs",
    "release:pin-bun": "node tools/pack.mjs --pin-bun",
    "pins:check": "node tools/check-pins.mjs",
    "spec:check": "node tools/generate-spec.mjs --check",
    "spec:gen": "node tools/generate-spec.mjs",
    "err-message:copy": "node tools/copy-err-message.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@fast-check/vitest": "^0.5.0",
    "@redis/client": "^6.2.1",
    "@swc/core": "^1.16.21",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.2",
    "git-cliff": "^2.14.2",
    "globby": "^16.2.4",
    "markdownlint-cli2": "^0.24.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2002",
    "publint": "^0.3.25",
    "reflect-metadata": "^0.2.2",
    "tough-cookie": "^6.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1"
  }
}
