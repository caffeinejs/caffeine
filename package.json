{
  "name": "caffeine",
  "version": "0.0.0",
  "description": "Caffeine monorepo",
  "license": "MIT",
  "author": "Vitor Hugo Salgado (https://github.com/vitorsalgado)",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "http",
    "http-fastify-adapter",
    "benchmarks"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "build:force": "tsc --build --force tsconfig.build.json",
    "clean": "tsc --build --clean tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "fmt": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.40",
    "@types/node": "^22.9.0",
    "eslint": "^10.3.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.6.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "unplugin-swc": "^1.5.9",
    "@fast-check/vitest": "^0.4.1",
    "fast-check": "^4.8.0",
    "globby": "^16.0.0",
    "uuid": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "vitest": "^4.1.8"
