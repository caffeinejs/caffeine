{
  "name": "@caffeinejs/resilience",
  "version": "0.0.0",
  "description": "Circuit breaker and retry for CaffeineJS",
  "license": "MIT",
  "author": "Vitor Hugo Salgado (https://github.com/vitorsalgado)",
  "homepage": "https://github.com/caffeinejs/caffeine/tree/main/resilience#readme",
  "bugs": {
    "url": "https://github.com/caffeinejs/caffeine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caffeinejs/caffeine.git",
    "directory": "resilience"
  },
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./otel": {
      "types": "./dist/otel/index.d.ts",
      "default": "./dist/otel/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.d.ts.map",
    "!dist/**/_spectypes"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@caffeinejs/std": "0.0.0",
    "@opentelemetry/api": ">=1 <2"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-prometheus": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0"
  }
}
