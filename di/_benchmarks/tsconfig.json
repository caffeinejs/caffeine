{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "rootDir": "..",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "types": ["node"],
    "paths": {
      "@caffeinejs/di": ["../index.ts"],
      "@caffeinejs/di/decorators": ["../decorators/index.ts"],
      "@caffeinejs/di/internals": ["../decorators/registrar/index.ts"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": ["**/dist/**", "**/node_modules/**", "./_testdata/third_party_legacy/**"]
}
