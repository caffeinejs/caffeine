{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "lib": ["esnext", "DOM", "Decorators", "esnext.decorators"],
    "types": ["node"]
  },
  "exclude": [
    "dist",
    "node_modules",
    "**/_tests/",
    "**/_testdata/",
    "**/_benchmarks/",
    "**/examples/",
    "**/tools/",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
