{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CookieConfigSchema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "secret": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "algorithm": {
      "anyOf": [
        {
          "const": "SHA-256",
          "type": "string"
        },
        {
          "const": "SHA-384",
          "type": "string"
        },
        {
          "const": "SHA-512",
          "type": "string"
        }
      ]
    }
  }
}
