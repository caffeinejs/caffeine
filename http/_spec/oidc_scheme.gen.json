{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OIDCSchemeConfigSchema",
  "type": "object",
  "properties": {
    "clientId": {
      "type": "string"
    },
    "clientSecret": {
      "type": "string"
    },
    "sessionSecret": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "discoveryUrl": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "authorizationEndpoint": {
      "type": "string"
    },
    "tokenEndpoint": {
      "type": "string"
    },
    "userInfoEndpoint": {
      "type": "string"
    },
    "jwksUri": {
      "type": "string"
    },
    "callbackUrl": {
      "type": "string"
    },
    "defaultRedirectPath": {
      "type": "string"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sessionCookieName": {
      "type": "string"
    },
    "sessionCookieTtlSeconds": {
      "type": "number"
    },
    "stateCookieName": {
      "type": "string"
    },
    "secureCookie": {
      "type": "boolean"
    },
    "cookieDomain": {
      "type": "string"
    },
    "cookiePartitioned": {
      "type": "boolean"
    },
    "cookiePriority": {
      "anyOf": [
        {
          "const": "low",
          "type": "string"
        },
        {
          "const": "medium",
          "type": "string"
        },
        {
          "const": "high",
          "type": "string"
        }
      ]
    },
    "roleClaimType": {
      "type": "string"
    },
    "allowPlainPkce": {
      "type": "boolean"
    },
    "clockToleranceSeconds": {
      "type": "number"
    },
    "httpTimeoutMs": {
      "type": "number"
    },
    "discoveryCacheTtlSeconds": {
      "type": "number"
    },
    "tokenEndpointAuthMethod": {
      "anyOf": [
        {
          "const": "auto",
          "type": "string"
        },
        {
          "const": "client_secret_basic",
          "type": "string"
        },
        {
          "const": "client_secret_post",
          "type": "string"
        }
      ]
    },
    "showPii": {
      "type": "boolean"
    },
    "challengeMode": {
      "anyOf": [
        {
          "const": "auto",
          "type": "string"
        },
        {
          "const": "redirect",
          "type": "string"
        },
        {
          "const": "status",
          "type": "string"
        }
      ]
    },
    "loginPath": {
      "type": "string"
    },
    "getClaimsFromUserInfoEndpoint": {
      "type": "boolean"
    },
    "saveTokens": {
      "type": "boolean"
    },
    "postLogoutRedirectUri": {
      "type": "string"
    },
    "endSessionEndpoint": {
      "type": "string"
    },
    "prompt": {
      "anyOf": [
        {
          "const": "none",
          "type": "string"
        },
        {
          "const": "login",
          "type": "string"
        },
        {
          "const": "consent",
          "type": "string"
        },
        {
          "const": "select_account",
          "type": "string"
        }
      ]
    },
    "loginHint": {
      "type": "string"
    },
    "acrValues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maxAgeSeconds": {
      "type": "number"
    },
    "extraAuthorizationParams": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "type": "string"
        }
      }
    }
  }
}
