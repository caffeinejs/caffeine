{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CORSConfigSchema",
  "type": "object",
  "properties": {
    "origins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "credentials": {
      "type": "boolean"
    },
    "allowedHeaders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exposedHeaders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maxAge": {
      "pattern": "^(?:0|(?:(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:ns|us|µs|μs|ms|s|m|h|d))+)$",
      "type": "string"
    }
  }
}
