{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MultipartConfigSchema",
  "propertyNames": {
    "enum": [
      "maxPartSize",
      "maxFieldSize",
      "maxBufferedSize",
      "maxHeaderSize",
      "maxHeaders",
      "maxParts",
      "maxFiles",
      "maxDepth"
    ]
  },
  "additionalProperties": {},
  "type": "object",
  "properties": {
    "maxPartSize": {
      "allOf": [
        {
          "pattern": "[1-9]"
        }
      ],
      "pattern": "^\\d+(?:[bB]|[kKmMgGtTpP][bB]?)?$",
      "type": "string"
    },
    "maxFieldSize": {
      "allOf": [
        {
          "pattern": "[1-9]"
        }
      ],
      "pattern": "^\\d+(?:[bB]|[kKmMgGtTpP][bB]?)?$",
      "type": "string"
    },
    "maxBufferedSize": {
      "allOf": [
        {
          "pattern": "[1-9]"
        }
      ],
      "pattern": "^\\d+(?:[bB]|[kKmMgGtTpP][bB]?)?$",
      "type": "string"
    },
    "maxHeaderSize": {
      "allOf": [
        {
          "pattern": "[1-9]"
        }
      ],
      "pattern": "^\\d+(?:[bB]|[kKmMgGtTpP][bB]?)?$",
      "type": "string"
    },
    "maxHeaders": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxParts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxFiles": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxDepth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    }
  }
}
