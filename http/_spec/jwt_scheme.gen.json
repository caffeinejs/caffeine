{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JWTSchemeConfigSchema",
  "type": "object",
  "properties": {
    "secret": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "audience": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "algorithm": {
      "type": "string"
    },
    "expiresIn": {
      "pattern": "^(?:0|(?:(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:ns|us|µs|μs|ms|s|m|h|d))+)$",
      "type": "string"
    },
    "roleClaimType": {
      "type": "string"
    },
    "includeErrorDetails": {
      "type": "boolean"
    }
  }
}
