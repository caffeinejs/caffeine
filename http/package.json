{
  "name": "@caffeinejs/http",
  "version": "0.0.0",
  "description": "Caffeine http fastify adapter package",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./attachment": {
      "types": "./dist/core/attachment/index.d.ts",
      "default": "./dist/core/attachment/index.js"
    },
    "./constraints": {
      "types": "./dist/core/constraints/index.d.ts",
      "default": "./dist/core/constraints/index.js"
    },
    "./cookie": {
      "types": "./dist/core/cookie/index.d.ts",
      "default": "./dist/core/cookie/index.js"
    },
    "./csrf": {
      "types": "./dist/core/csrf/index.d.ts",
      "default": "./dist/core/csrf/index.js"
    },
    "./decorators": {
      "types": "./dist/decorators/index.d.ts",
      "default": "./dist/decorators/index.js"
    },
    "./decorators/registrar": {
      "types": "./dist/decorators/registrar/index.d.ts",
      "default": "./dist/decorators/registrar/index.js"
    },
    "./error": {
      "types": "./dist/core/error/index.d.ts",
      "default": "./dist/core/error/index.js"
    },
    "./fastify": {
      "types": "./dist/platform/fastify/index.d.ts",
      "default": "./dist/platform/fastify/index.js"
    },
    "./guards": {
      "types": "./dist/core/guards/index.d.ts",
      "default": "./dist/core/guards/index.js"
    },
    "./health": {
      "types": "./dist/core/health/index.d.ts",
      "default": "./dist/core/health/index.js"
    },
    "./listener": {
      "types": "./dist/core/listener/index.d.ts",
      "default": "./dist/core/listener/index.js"
    },
    "./middleware": {
      "types": "./dist/core/middleware/index.d.ts",
      "default": "./dist/core/middleware/index.js"
    },
    "./routing": {
      "types": "./dist/core/routing/index.d.ts",
      "default": "./dist/core/routing/index.js"
    },
    "./security": {
      "types": "./dist/core/security/index.d.ts",
      "default": "./dist/core/security/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run",
    "test:memory": "vitest run --config vitest.leak.config.ts"
  },
  "dependencies": {
    "@caffeinejs/application": "*",
    "@caffeinejs/di": "*",
    "@caffeinejs/std": "*",
    "cookie": "^2.0.1",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.10",
    "path-to-regexp": "^8.4.2"
  },
  "devDependencies": {
    "@caffeinejs/testing": "*",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "zod": "^4.6.5"
  }
}
