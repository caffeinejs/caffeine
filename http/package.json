{
  "name": "@caffeinejs/http",
  "version": "0.0.0",
  "description": "Caffeine http fastify adapter package",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./decorators": {
      "types": "./dist/decorators/index.d.ts",
      "default": "./dist/decorators/index.js"
    },
    "./decorators/registrar": {
      "types": "./dist/decorators/registrar/index.d.ts",
      "default": "./dist/decorators/registrar/index.js"
    },
    "./guards": {
      "types": "./dist/guards/index.d.ts",
      "default": "./dist/guards/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@caffeinejs/di": "*",
    "@caffeinejs/std": "*",
    "jose": "^5.0.0",
    "lru-cache": "^11.0.0"
  },
  "peerDependencies": {
    "@fastify/cookie": "^11.0.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@fastify/cookie": {
      "optional": false
    },
    "fastify": {
      "optional": false
    },
    "fastify-plugin": {
      "optional": false
    }
  },
  "devDependencies": {
    "@fastify/cookie": "^11.0.2",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "zod": "^4.4.3"
  }
}
