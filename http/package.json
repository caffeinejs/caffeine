{
  "name": "@caffeinejs/http",
  "version": "0.0.0",
  "description": "Caffeine http package",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/commonjs/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./decorators": {
      "import": {
        "types": "./dist/esm/decorators.d.ts",
        "default": "./dist/esm/decorators.js"
      },
      "require": {
        "types": "./dist/commonjs/decorators.d.ts",
        "default": "./dist/commonjs/decorators.js"
      }
    },
    "./decorators/registrar": {
      "import": {
        "types": "./dist/esm/decorators/registrar/index.d.ts",
        "default": "./dist/esm/decorators/registrar/index.js"
      },
      "require": {
        "types": "./dist/commonjs/decorators/registrar/index.d.ts",
        "default": "./dist/commonjs/decorators/registrar/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --build --force tsconfig.build.json && npm run build:cjs",
    "build:cjs": "node ../tools/build-cjs.mjs",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@caffeinejs/core": "*"
  }
}
