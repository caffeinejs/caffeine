{
  "name": "@caffeinejs/http",
  "version": "0.0.0",
  "description": "Caffeine http fastify adapter package",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./decorators": {
      "types": "./dist/decorators/index.d.ts",
      "default": "./dist/decorators/index.js"
    },
    "./decorators/registrar": {
      "types": "./dist/decorators/registrar/index.d.ts",
      "default": "./dist/decorators/registrar/index.js"
    },
    "./guards": {
      "types": "./dist/guards/index.d.ts",
      "default": "./dist/guards/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@caffeinejs/di": "*",
    "@caffeinejs/std": "*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/middie": "^9.3.4",
    "fastify": "^5.12.4",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "zod": "^4.5.4"
  }
}
