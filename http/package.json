{
  "name": "@caffeinejs/http",
  "version": "0.0.0",
  "description": "Caffeine HTTP: a web-standards server for Node and fetch runtimes",
  "license": "MIT",
  "author": "Vitor Hugo Salgado (https://github.com/vitorsalgado)",
  "homepage": "https://github.com/caffeinejs/caffeine/tree/main/http#readme",
  "bugs": {
    "url": "https://github.com/caffeinejs/caffeine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caffeinejs/caffeine.git",
    "directory": "http"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./attachment": {
      "types": "./dist/core/attachment/index.d.ts",
      "default": "./dist/core/attachment/index.js"
    },
    "./bff": {
      "types": "./dist/core/bff/index.d.ts",
      "default": "./dist/core/bff/index.js"
    },
    "./bun": {
      "types": "./dist/platform/bun/index.d.ts",
      "default": "./dist/platform/bun/index.js"
    },
    "./compress": {
      "types": "./dist/core/compress/index.d.ts",
      "default": "./dist/core/compress/index.js"
    },
    "./conditional": {
      "types": "./dist/core/conditional/index.d.ts",
      "default": "./dist/core/conditional/index.js"
    },
    "./constraints": {
      "types": "./dist/core/constraints/index.d.ts",
      "default": "./dist/core/constraints/index.js"
    },
    "./cookie": {
      "types": "./dist/core/cookie/index.d.ts",
      "default": "./dist/core/cookie/index.js"
    },
    "./cors": {
      "types": "./dist/core/cors/index.d.ts",
      "default": "./dist/core/cors/index.js"
    },
    "./csrf": {
      "types": "./dist/core/csrf/index.d.ts",
      "default": "./dist/core/csrf/index.js"
    },
    "./decorators": {
      "types": "./dist/decorators/index.d.ts",
      "default": "./dist/decorators/index.js"
    },
    "./decorators/registrar": {
      "types": "./dist/decorators/registrar/index.d.ts",
      "default": "./dist/decorators/registrar/index.js"
    },
    "./error": {
      "types": "./dist/core/error/index.d.ts",
      "default": "./dist/core/error/index.js"
    },
    "./guards": {
      "types": "./dist/core/guards/index.d.ts",
      "default": "./dist/core/guards/index.js"
    },
    "./health": {
      "types": "./dist/core/health/index.d.ts",
      "default": "./dist/core/health/index.js"
    },
    "./listener": {
      "types": "./dist/core/listener/index.d.ts",
      "default": "./dist/core/listener/index.js"
    },
    "./middleware": {
      "types": "./dist/core/middleware/index.d.ts",
      "default": "./dist/core/middleware/index.js"
    },
    "./node": {
      "types": "./dist/platform/node/index.d.ts",
      "default": "./dist/platform/node/index.js"
    },
    "./range": {
      "types": "./dist/core/range/index.d.ts",
      "default": "./dist/core/range/index.js"
    },
    "./routing": {
      "types": "./dist/core/routing/index.d.ts",
      "default": "./dist/core/routing/index.js"
    },
    "./security": {
      "types": "./dist/core/security/index.d.ts",
      "default": "./dist/core/security/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.d.ts.map",
    "!dist/**/_spectypes"
  ],
  "engines": {
    "node": "^24.20.0 || >=26.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run && vitest run --config vitest.engine.config.ts",
    "test:memory": "vitest run --config vitest.leak.config.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "@standard-schema/spec": "^1.1.0",
    "ajv-formats": "^3.0.1",
    "cookie": "^2.0.1",
    "fast-json-stringify": "^7.3.6",
    "find-my-way": "^9.10.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.10",
    "light-my-request": "^6.6.0",
    "negotiator": "^1.1.0",
    "path-to-regexp": "^8.4.2",
    "secure-json-parse": "^4.1.1"
  },
  "peerDependencies": {
    "@caffeinejs/application": "0.0.0",
    "@caffeinejs/di": "0.0.0",
    "@caffeinejs/std": "0.0.0"
  },
  "devDependencies": {
    "@caffeinejs/resilience": "0.0.0",
    "@caffeinejs/testing": "0.0.0",
    "@types/cors": "^2.8.19",
    "@types/negotiator": "^0.6.5",
    "cors": "^2.8.6",
    "zod": "^4.6.5"
  }
}
