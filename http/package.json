{
  "name": "@caffeinejs/http",
  "version": "0.0.0",
  "description": "Caffeine http package",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./decorators": {
      "types": "./dist/esm/decorators.d.ts",
      "default": "./dist/esm/decorators.js"
    },
    "./decorators/registrar": {
      "types": "./dist/esm/decorators/registrar/index.d.ts",
      "default": "./dist/esm/decorators/registrar/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --build --force tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@caffeinejs/core": "*"
  }
}
