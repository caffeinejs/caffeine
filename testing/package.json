{
  "name": "@caffeinejs/testing",
  "version": "0.0.0",
  "description": "CaffeineJS testing utilities",
  "license": "MIT",
  "author": "Vitor Hugo Salgado (https://github.com/vitorsalgado)",
  "homepage": "https://github.com/caffeinejs/caffeine/tree/main/testing#readme",
  "bugs": {
    "url": "https://github.com/caffeinejs/caffeine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caffeinejs/caffeine.git",
    "directory": "testing"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./tls": {
      "types": "./dist/tls/index.d.ts",
      "default": "./dist/tls/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.d.ts.map",
    "!dist/**/_spectypes"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@caffeinejs/brewer": "0.0.0",
    "@caffeinejs/di": "0.0.0",
    "@caffeinejs/http": "0.0.0",
    "@caffeinejs/std": "0.0.0"
  },
  "peerDependenciesMeta": {
    "@caffeinejs/brewer": {
      "optional": true
    },
    "@caffeinejs/http": {
      "optional": true
    },
    "@caffeinejs/std": {
      "optional": true
    }
  },
  "devDependencies": {
    "@caffeinejs/application": "0.0.0",
    "@caffeinejs/brewer": "0.0.0",
    "@caffeinejs/di": "0.0.0",
    "@caffeinejs/http": "0.0.0",
    "@caffeinejs/std": "0.0.0",
    "fastify": "^5.12.8"
  }
}
