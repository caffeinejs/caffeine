{
  "name": "@caffeinejs/testing",
  "version": "0.0.0",
  "description": "CaffeineJS HTTP testing utilities",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./experimental": {
      "types": "./dist/experimental/index.d.ts",
      "default": "./dist/experimental/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --build --force tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@caffeinejs/core": "*",
    "@caffeinejs/http": "*"
  },
  "devDependencies": {
    "@caffeinejs/http-fastify-adapter": "*",
    "fastify": "^5.8.5"
  }
}
