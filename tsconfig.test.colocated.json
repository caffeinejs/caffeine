{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "@kitajs/html",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "tsBuildInfoFile": "./.cache/tsconfig.test.colocated.tsbuildinfo",
    "paths": {
      "@caffeinejs/brewer": ["./brewer/index.ts"],
      "@caffeinejs/compress": ["./compress/index.ts"],
      "@caffeinejs/cors": ["./cors/index.ts"],
      "@caffeinejs/di": ["./di/index.ts"],
      "@caffeinejs/html": ["./html/index.ts"],
      "@caffeinejs/http": ["./http/index.ts"],
      "@caffeinejs/multipart": ["./multipart/index.ts"],
      "@caffeinejs/static": ["./static/index.ts"],
      "@caffeinejs/view": ["./view/index.ts"]
    }
  },
  "include": [
    "brewer/**/*.test.ts",
    "brewer/**/*.spec.ts",
    "di/**/*.test.ts",
    "di/**/*.spec.ts",
    "http/**/*.test.ts",
    "http/**/*.spec.ts",
    "cors/**/*.test.ts",
    "cors/**/*.spec.ts",
    "compress/**/*.test.ts",
    "compress/**/*.spec.ts",
    "html/**/*.test.ts",
    "html/**/*.test.tsx",
    "html/**/*.spec.ts",
    "html/**/*.spec.tsx",
    "multipart/**/*.test.ts",
    "multipart/**/*.spec.ts",
    "static/**/*.test.ts",
    "static/**/*.spec.ts",
    "view/**/*.test.ts",
    "view/**/*.spec.ts"
  ],
  "exclude": [
    "**/dist",
    "**/node_modules",
    "di/decorators/legacy/**",
    "cli/**"
  ]
}
