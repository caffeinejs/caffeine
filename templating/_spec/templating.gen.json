                "maxAssetSize": {
                  "pattern": "^\\d+(?:[bB]|[kKmMgGtTpP][bB]?)?$",
                  "type": "string"
                },
                "maxBundleSize": {
                  "pattern": "^\\d+(?:[bB]|[kKmMgGtTpP][bB]?)?$",
                  "type": "string"
                },
                "maxPartials": {
                  "minimum": 1,
                  "type": "integer"
                },
                "maxOutputSize": {
                  "pattern": "^\\d+(?:[bB]|[kKmMgGtTpP][bB]?)?$",
                  "type": "string"
                }
