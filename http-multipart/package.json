{
  "name": "@caffeinejs/http-multipart",
  "version": "0.0.0",
  "description": "Caffeine HTTP multipart pickers",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --build --force tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@caffeinejs/http": "*",
    "@caffeinejs/std": "*"
  },
  "peerDependencies": {
    "@fastify/multipart": "^10.0.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@caffeinejs/di": "*",
    "@fastify/multipart": "^10.0.0",
    "fastify": "^5.8.5"
  }
}
