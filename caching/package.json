{
  "name": "@caffeinejs/caching",
  "version": "0.0.0",
  "description": "Caffeine HTTP response caching",
  "license": "MIT",
  "author": "Vitor Hugo Salgado (https://github.com/vitorsalgado)",
  "homepage": "https://github.com/caffeinejs/caffeine/tree/main/caching#readme",
  "bugs": {
    "url": "https://github.com/caffeinejs/caffeine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caffeinejs/caffeine.git",
    "directory": "caching"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./store/memory": {
      "types": "./dist/store/memory/index.d.ts",
      "default": "./dist/store/memory/index.js"
    },
    "./store/redis": {
      "types": "./dist/store/redis/index.d.ts",
      "default": "./dist/store/redis/index.js"
    },
    "./store/keyv": {
      "types": "./dist/store/keyv/index.d.ts",
      "default": "./dist/store/keyv/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.d.ts.map",
    "!dist/**/_spectypes"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify-plugin": "^6.0.0"
  },
  "peerDependencies": {
    "@caffeinejs/application": "0.0.0",
    "@caffeinejs/di": "0.0.0",
    "@caffeinejs/http": "0.0.0",
    "@caffeinejs/std": "0.0.0",
    "@redis/client": "^6.2.1",
    "cache-manager": "^7.2.9",
    "fastify": "^5.0.0",
    "keyv": "^5.6.0",
    "lru-cache": "^11.5.2"
  },
  "peerDependenciesMeta": {
    "@caffeinejs/application": {
      "optional": true
    },
    "@caffeinejs/di": {
      "optional": true
    },
    "@caffeinejs/http": {
      "optional": true
    },
    "@redis/client": {
      "optional": true
    },
    "cache-manager": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "keyv": {
      "optional": true
    },
    "lru-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "cache-manager": "^7.2.9",
    "fastify": "^5.12.8",
    "keyv": "^5.6.0",
    "lru-cache": "^11.5.2"
  }
}
