{
  "name": "@caffeinejs/caching",
  "version": "0.0.0",
  "description": "Caffeine HTTP response caching",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./store/memory": {
      "types": "./dist/store/memory/index.d.ts",
      "default": "./dist/store/memory/index.js"
    },
    "./store/redis": {
      "types": "./dist/store/redis/index.d.ts",
      "default": "./dist/store/redis/index.js"
    },
    "./store/keyv": {
      "types": "./dist/store/keyv/index.d.ts",
      "default": "./dist/store/keyv/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@caffeinejs/di": "*",
    "@caffeinejs/http": "*",
    "@caffeinejs/std": "*",
    "@redis/client": "^6.2.1",
    "cache-manager": "^7.2.9",
    "fastify": "^5.0.0",
    "keyv": "^5.6.0",
    "lru-cache": "^11.5.2"
  },
  "peerDependenciesMeta": {
    "@redis/client": {
      "optional": true
    },
    "cache-manager": {
      "optional": true
    },
    "keyv": {
      "optional": true
    },
    "lru-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "cache-manager": "^7.2.9",
    "fastify": "^5.12.4",
    "keyv": "^5.6.0",
    "lru-cache": "^11.5.2"
  }
}
