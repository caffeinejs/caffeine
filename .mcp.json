{
  "mcpServers": {
    "sonarqube": {
      "type": "http",
      "url": "https://api.sonarcloud.io/mcp",
      "headers": {
        "Authorization": "Bearer ${CAFFEINE_SONARQUBE_TOKEN}",
        "SONARQUBE_ORG": "caffeinejs",
        "SONARQUBE_READ_ONLY": "true",
        "SONARQUBE_TOOLSETS": "issues,rules,quality-gates,measures"
      }
    },
    "scorecard": {
      "type": "stdio",
      "command": "scorecard-mcp"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${CAFFEINE_GITHUB_MCP_TOKEN}",
        "X-MCP-Readonly": "true",
        "X-MCP-Toolsets": "context,issues,pull_requests,actions,code_security,dependabot,secret_protection"
      }
    }
  }
}
