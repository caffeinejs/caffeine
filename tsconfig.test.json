{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "jsx": "preserve",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "exclude": [
    "**/dist",
    "**/node_modules",
    "core/decorators/legacy/**"
  ]
}
