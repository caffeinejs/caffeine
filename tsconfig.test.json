{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "jsx": "preserve",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@caffeinejs/di": ["./di/index.ts"],
      "@caffeinejs/http": ["./http/index.ts"]
    }
  },
  "include": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "test/**/*.e2e.ts"
  ],
  "exclude": [
    "**/dist",
    "**/node_modules",
    "di/decorators/legacy/**",
    "cli/**"
  ]
}
