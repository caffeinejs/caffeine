{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "startup/nestjs/**",
    "startup/caffeine/**",
    "helloworld/caffeine/**",
    "helloworld/caffeine-router/**",
    "request/caffeine/**",
    "request/caffeine-middleware/**",
    "request/caffeine-request-scope/**",
    "mixedscopes/caffeine/**",
    "aspect/**",
    "di/**"
  ]
}
