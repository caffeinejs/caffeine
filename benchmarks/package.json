{
  "name": "@caffeinejs/benchmarks",
  "version": "0.0.0",
  "description": "CaffeineJS benchmarks",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "node --import=tsx",
    "build": "tsc -p tsconfig.nestjs.json && npm run bench:startup:compile && npm run bench:startup:caffeine:compile && npm run bench:fixtures:compile && npm run bench:caffeine:compile",
    "bench:startup:compile": "esbuild startup/nestjs/app.ts startup/nestjs/memory.ts startup/fastify/app.ts startup/hono/app.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outdir=startup/dist --tsconfig=tsconfig.startup.json",
    "bench:startup:caffeine:compile": "esbuild startup/caffeine/app.ts startup/caffeine/memory.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outbase=startup --outdir=startup/dist --tsconfig=request/caffeine/tsconfig.json",
    "bench:fixtures:compile": "esbuild request/fastify/fastify.ts request/hono/hono.ts request/elysia/elysia.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outbase=. --outdir=dist --tsconfig=tsconfig.nestjs.json",
    "bench:caffeine:compile": "esbuild helloworld/caffeine/caffeine.ts request/caffeine/caffeine.ts request/caffeine-middleware/caffeine.ts request/caffeine-request-scope/caffeine.ts mixedscopes/caffeine/caffeine.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outbase=. --outdir=dist --tsconfig=request/caffeine/tsconfig.json",
    "bench:helloworld": "node --import=tsx helloworld/bench.ts",
    "bench:startup": "node --import=tsx startup/bench.ts",
    "bench:memory": "node --import=tsx startup/memory.bench.ts",
    "bench:request": "node --import=tsx request/bench.ts",
    "bench:request:bun": "node --import=tsx runtimes/bun/request/bench.ts",
    "bench:mixedscopes": "node --import=tsx mixedscopes/bench.ts",
    "bench:aspect": "node --import=tsx aspect/bench.ts",
    "test:typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.nestjs.json --noEmit && tsc -p runtimes/bun/tsconfig.json --noEmit",
    "test:request": "node --import=tsx request/test.ts",
    "test:request:bun": "node --import=tsx runtimes/bun/request/test.ts",
    "bench:profile": "node --import=tsx profiling/run.ts"
  },
  "dependencies": {
    "@adonisjs/application": "^9.0.1",
    "@adonisjs/encryption": "^6.0.2",
    "@adonisjs/events": "^10.2.0",
    "@adonisjs/http-server": "^9.1.0",
    "@adonisjs/logger": "^7.1.1",
    "@caffeinejs/di": "*",
    "@caffeinejs/std": "*",
    "@caffeinejs/http": "*",
    "@elysiajs/node": "^1.4.5",
    "@hono/node-server": "^2.1.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.27",
    "@trpc/server": "^11.0.0",
    "ajv": "^6.15.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "elysia": "^1.4.29",
    "express": "^5.0.0",
    "fast-json-stringify": "^6.4.0",
    "fastify": "^5.0.0",
    "hono": "^4.13.5",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/bun": "^1.3.14",
    "@types/express": "^5.0.0",
    "autocannon": "^8.0.0",
    "esbuild": "^0.28.2",
    "mitata": "^1.0.34",
    "tsx": "^4.22.4"
  }
}
