{
  "name": "@caffeinejs/benchmarks",
  "version": "0.0.0",
  "description": "CaffeineJS benchmarks",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "node --import=tsx",
    "build": "tsc -p tsconfig.nestjs.json && npm run bench:startup:compile && npm run bench:startup:caffeine:compile && npm run bench:fixtures:compile && npm run bench:caffeine:compile && npm run bench:fastify:compile",
    "bench:startup:compile": "esbuild startup/nestjs/app.ts startup/nestjs/memory.ts startup/fastify/app.ts startup/hono/app.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outdir=startup/dist --tsconfig=tsconfig.startup.json",
    "bench:startup:caffeine:compile": "esbuild startup/caffeine/app.ts startup/caffeine/memory.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outbase=startup --outdir=startup/dist --tsconfig=request/caffeine/tsconfig.json",
    "bench:fixtures:compile": "esbuild request/fastify/fastify.ts request/hono/hono.ts request/elysia/elysia.ts request/express/express.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outbase=. --outdir=dist --tsconfig=tsconfig.nestjs.json",
    "bench:caffeine:compile": "esbuild helloworld/caffeine/caffeine.ts helloworld/caffeine-router/caffeine-router.ts request/caffeine/caffeine.ts request/caffeine-middleware/caffeine.ts request/caffeine-request-scope/caffeine.ts mixedscopes/caffeine/caffeine.ts authn/caffeine/caffeine.ts caching/caffeine/caffeine.ts testing/caffeine/run.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outbase=. --outdir=dist --tsconfig=request/caffeine/tsconfig.json",
    "bench:helloworld": "node --import=tsx helloworld/bench.ts",
    "bench:startup": "node --import=tsx startup/bench.ts",
    "bench:memory": "node --import=tsx startup/memory.bench.ts",
    "bench:request": "node --import=tsx request/bench.ts",
    "bench:request:bun": "node --import=tsx runtimes/bun/request/bench.ts",
    "bench:fastify:compile": "esbuild fastify/bare.ts fastify/fetch.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outbase=. --outdir=dist --tsconfig=tsconfig.json",
    "bench:fastify": "node --import=tsx fastify/bench.ts",
    "bench:mixedscopes": "node --import=tsx mixedscopes/bench.ts",
    "bench:authn": "node --import=tsx authn/bench.ts",
    "bench:caching": "node --import=tsx caching/bench.ts",
    "bench:testing": "node --expose-gc --import=tsx testing/bench.ts",
    "bench:aspect": "node --expose-gc --import=tsx aspect/bench.ts",
    "bench:resilience": "node --expose-gc --import=tsx resilience/bench.ts",
    "bench:config-read": "node --expose-gc --import=tsx config/read.bench.ts",
    "bench:config-reload": "node --expose-gc --import=tsx config/reload.bench.ts",
    "bench:di": "node --expose-gc --import=tsx di/container.bench.ts",
    "bench:di-compile": "node --expose-gc --import=tsx di/compile.bench.ts",
    "bench:di-compare": "node --expose-gc --import=tsx di/compare_third_parties.bench.ts",
    "bench:di-perf": "node --expose-gc --import=tsx di/perf_compare.bench.ts",
    "bench:di:compile-legacy": "tsc -p di/testdata/third_party_legacy/tsconfig.json",
    "test:typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.caffeine.json --noEmit && tsc -p tsconfig.nestjs.json --noEmit && tsc -p startup/nestjs/tsconfig.json --noEmit && tsc -p runtimes/bun/tsconfig.json --noEmit && tsc -p di/tsconfig.json --noEmit",
    "test:request": "node --import=tsx request/test.ts",
    "test:request:bun": "node --import=tsx runtimes/bun/request/test.ts",
    "test:fastify": "node --import=tsx fastify/test.ts",
    "test:authn": "node --import=tsx authn/test.ts",
    "test:testing": "node --import=tsx testing/test.ts",
    "test:mixedscopes": "node --import=tsx mixedscopes/test.ts",
    "test:caching": "node --import=tsx caching/test.ts",
    "test:fixtures": "npm run test:request && npm run test:fastify && npm run test:authn && npm run test:mixedscopes && npm run test:caching && npm run test:testing"
  },
  "devDependencies": {
    "@adonisjs/application": "^9.1.0",
    "@adonisjs/encryption": "^6.0.2",
    "@adonisjs/events": "^10.2.0",
    "@adonisjs/http-server": "^9.3.0",
    "@adonisjs/logger": "^7.1.1",
    "@caffeinejs/caching": "*",
    "@caffeinejs/di": "*",
    "@caffeinejs/http": "*",
    "@caffeinejs/resilience": "*",
    "@caffeinejs/std": "*",
    "@caffeinejs/testing": "*",
    "@elysiajs/node": "^1.4.5",
    "@fastify/fetch": "^0.1.0",
    "@hono/node-server": "^2.1.1",
    "@inferdi/inferdi": "^6.1.0",
    "@loopback/context": "^8.0.15",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/platform-fastify": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@trpc/server": "^11.0.0",
    "@types/autocannon": "^7.12.7",
    "@types/bun": "^1.4.2",
    "@types/express": "^5.0.0",
    "@types/opossum": "^8.1.9",
    "@types/passport-jwt": "^4.0.1",
    "ajv": "^8.20.0",
    "autocannon": "^8.0.0",
    "awilix": "^13.0.3",
    "cache-manager": "^7.2.9",
    "cockatiel": "^4.0.0",
    "elysia": "^1.4.30",
    "esbuild": "^0.28.2",
    "express": "^5.0.0",
    "fast-json-stringify": "^7.0.1",
    "fastify": "^5.12.4",
    "hono": "^4.13.8",
    "injection-js": "^2.6.1",
    "inversify": "^8.2.3",
    "keyv": "^5.6.0",
    "mitata": "^1.0.34",
    "opossum": "^10.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.23.13",
    "tsyringe": "^4.10.0",
    "typedi": "^0.10.0",
    "zod": "^4.6.5"
  }
}
