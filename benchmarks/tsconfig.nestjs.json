{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2022",
    "moduleResolution": "nodenext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "helloworld/nestjs/nestjs.ts",
    "request/nestjs/nestjs.ts",
    "request/nestjs-express/nestjs.ts",
    "mixedscopes/nestjs/nestjs.ts",
    "authn/nestjs/nestjs.ts",
    "authn/shared.ts",
    "testing/nestjs/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
