{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StaticConfigSchema",
  "type": "object",
  "properties": {
    "mounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "root"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "anonymous": {
            "type": "boolean"
          },
          "mode": {
            "anyOf": [
              {
                "const": "manifest",
                "type": "string"
              },
              {
                "const": "scan",
                "type": "string"
              }
            ]
          },
          "index": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "const": false,
                "type": "boolean"
              }
            ]
          },
          "unrouted": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cacheControl": {
            "type": "string"
          },
          "immutableMaxAge": {
            "pattern": "^(?:0|(?:(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:ns|us|µs|μs|ms|s|m|h|d))+)$",
            "type": "string"
          },
          "immutable": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
