{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StaticConfigSchema",
  "type": "object",
  "properties": {
    "mounts": {
      "type": "array",
      "items": {
        "additionalProperties": {},
        "type": "object",
        "required": [
          "root"
        ],
        "properties": {
          "root": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "anonymous": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
