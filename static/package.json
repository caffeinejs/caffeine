{
  "name": "@caffeinejs/static",
  "version": "0.0.0",
  "description": "Caffeine static file serving plugin",
  "license": "MIT",
  "author": "Vitor Hugo Salgado (https://github.com/vitorsalgado)",
  "homepage": "https://github.com/caffeinejs/caffeine/tree/main/static#readme",
  "bugs": {
    "url": "https://github.com/caffeinejs/caffeine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caffeinejs/caffeine.git",
    "directory": "static"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.d.ts.map",
    "!dist/**/_spectypes"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.9",
    "fastify-plugin": "^6.0.0"
  },
  "peerDependencies": {
    "@caffeinejs/http": "0.0.0",
    "@caffeinejs/std": "0.0.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@caffeinejs/application": "0.0.0",
    "@caffeinejs/di": "0.0.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.8"
  }
}
