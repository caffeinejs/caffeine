{
  "name": "@caffeinejs/static",
  "version": "0.0.0",
  "description": "Caffeine static file serving plugin",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3"
  },
  "peerDependencies": {
    "@caffeinejs/di": "*",
    "@caffeinejs/http": "*",
    "@caffeinejs/std": "*",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.4"
  }
}
