{
  "name": "@caffeinejs/static",
  "version": "0.0.0",
  "description": "Caffeine static file serving plugin",
  "license": "MIT",
  "author": "Vitor Hugo Salgado (https://github.com/vitorsalgado)",
  "homepage": "https://github.com/caffeinejs/caffeine/tree/main/static#readme",
  "bugs": {
    "url": "https://github.com/caffeinejs/caffeine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caffeinejs/caffeine.git",
    "directory": "static"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "imports": {
    "#static-sha256": {
      "node": "./dist/web/_sha256_node.js",
      "default": "./dist/web/_sha256.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build/index.d.ts",
      "default": "./dist/build/index.js"
    },
    "./directory": {
      "types": "./dist/directory/index.d.ts",
      "default": "./dist/directory/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.d.ts.map",
    "!dist/**/_spectypes"
  ],
  "engines": {
    "node": "^24.22.0 || >=26.10.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@caffeinejs/http": "0.0.0",
    "@caffeinejs/std": "0.0.0",
    "@noble/hashes": "2.0.1"
  },
  "peerDependenciesMeta": {
    "@noble/hashes": {
      "optional": true
    }
  },
  "devDependencies": {
    "@caffeinejs/application": "0.0.0",
    "@caffeinejs/di": "0.0.0",
    "@caffeinejs/http-node": "0.0.0",
    "@noble/hashes": "2.0.1"
  }
}
